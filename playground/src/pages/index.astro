---
import Layout from '../layouts/Layout.astro';
import Header from '../components/sections/Header.astro';
import Footer from '../components/sections/Footer.astro';
import Categories from '../components/sections/Categories.astro';
import Languages from '../components/sections/Languages.astro';
import GuiOptions from '../components/sections/GuiOptions.astro';
import Themes from '../components/sections/Themes.astro';
import LiveConfig from '../components/sections/LiveConfig.astro';
import Installation from '../components/sections/Installation.astro';
---
<Layout>
    <Header/>
    <main class="workbench">
        <div class="workbench__steps">
            <Categories/>
            <Languages/>
            <GuiOptions/>
            <Themes/>
        </div>
        <LiveConfig/>
        <Installation/>
    </main>
    <Footer/>
</Layout>
<script>
    import '../modules/index'
</script>
